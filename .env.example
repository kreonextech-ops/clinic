# Database (PostgreSQL on Oracle VM)
DATABASE_URL=postgresql://dental_user:your_password@localhost:5432/dental_clinic

# NextAuth
NEXTAUTH_SECRET=your-random-secret-string-min-32-chars
NEXTAUTH_URL=https://yourclinic.com

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=dental-clinic-files
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=clinic@yourdomain.com
DOCTOR_EMAIL=doctor@gmail.com

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:doctor@gmail.com

# Cron Secret (to secure the daily reminder endpoint)
CRON_SECRET=your-random-cron-secret-string

# Clinic Info (used in PDF headers and email templates)
CLINIC_NAME=Your Dental Clinic
DOCTOR_NAME=Dr. Your Name
